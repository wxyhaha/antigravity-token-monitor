{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "Token & TPS Monitor",
  "description": "在右侧辅助栏实时监控当前对话及历史对话的 Token 消耗、Prompt 缓存命中率、TTFT 首字延迟与 TPS 生成速率。",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "Token & TPS Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "Token & TPS"
      }
    ]
  }
}
